<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SafeHouse programs on Windows: the process code page is UTF-8 (Windows 10 1903+), so argv, getenv, fopen and
     the other narrow-string APIs take the UTF-8 paths the code uses everywhere (a user folder like C:\Users\Zoë or
     a Japanese folder name works). Older Windows ignores the element. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
