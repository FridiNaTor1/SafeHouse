# cmake -DDIR=<launcher/assets/developers> -DNAMES=a,b,... -DOUTPUT=<header> -P embed-developers.cmake
# One header with every developer's picture and silhouette (cmake/developers.cmake) and the list of them, in order.
string(REPLACE "," ";" names "${NAMES}")
set(text "#pragma once\n// Generated by cmake/embed-developers.cmake from launcher/assets/developers (cmake/developers.cmake).\n#include <cstddef>\n")
set(list "")
foreach(name ${names})
 foreach(kind "" "-silhouette")
  string(MAKE_C_IDENTIFIER "cane_developer_${name}${kind}" symbol)
  file(READ "${DIR}/${name}${kind}.png" bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
  string(APPEND text "inline const unsigned char ${symbol}[] = {${bytes}};\n")
  string(APPEND list "    {${symbol}, sizeof(${symbol})},\n")
 endforeach()
endforeach()
string(APPEND text "struct CaneDeveloperPicture {\n    const unsigned char* data;\n    size_t size;\n};\n")
string(APPEND text "// each developer's picture, then its silhouette\ninline const CaneDeveloperPicture cane_developer_pictures[] = {\n${list}};\n")
file(WRITE "${OUTPUT}" "${text}")
