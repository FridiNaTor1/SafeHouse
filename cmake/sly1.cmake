# Sly 1: the game from the Sly1/ submodule (github.com/FridiNaTor1/Sly1-safehouse, branch `safehouse`: upstream
# theclub654/ProjectCane plus SafeHouse's patch series; notes/SLY1_PLAN_2026-11-20.md, docs/BUILDING.md).
# Included from the top-level CMakeLists.txt when CANE_BUILD_GAME is on, after cane_ui.
#
# Upstream's own top-level CMakeLists.txt is not used (it is not usable as a subproject: global CMAKE_* settings,
# CMAKE_BINARY_DIR outputs, generic target names); this file builds the same sources with SafeHouse's libraries
# (cane_ui: Dear ImGui, GLAD, GLFW), under the target name the launcher, packaging and tests use (Sly1-Release).
#
# CANE_SAFEHOUSE: the fork's platform/platform.h then forwards to SafeHouse's platform/platform.h, reached as
# <safehouse/platform.h> through a generated include folder (below), so the fork's own folders never shadow
# SafeHouse's and the other way round.
set(CANE_ROOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
set(SLY1_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Sly1" CACHE PATH "The Sly 1 submodule (the ProjectCane fork)")
set(SLY1_GAME_DIR "${SLY1_DIR}/Sly1-Release")
if(NOT EXISTS "${SLY1_GAME_DIR}/Sly1-Release.vcxproj")
 message(FATAL_ERROR "Sly 1's sources are missing (${SLY1_GAME_DIR}). The game is a git submodule: run "
  "`git submodule update --init` (or clone with --recursive), or configure with -DCANE_BUILD_GAME=OFF.")
endif()

# cane_sly1_game(TARGET): Sly 1's sources and its build settings on an existing target, whatever its kind: the desktop
# executable below, and later Android's libSly1-Release.so (cmake/android.cmake), iOS's framework (cmake/ios.cmake) and
# the Switch's game object (cmake/Switch.cmake), the way Sly 2 is built on each. Everything platform-neutral is here;
# the platform files add their own libraries (FFmpeg, audio, SDL2) and backends.
# The source list is the vcxproj's (as upstream's CMake does): new upstream files appear on their own. Re-configure
# when it changes, or an existing build directory misses a new source file (undefined symbols at the link).
function(cane_sly1_game target)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SLY1_GAME_DIR}/Sly1-Release.vcxproj")
 file(STRINGS "${SLY1_GAME_DIR}/Sly1-Release.vcxproj" source_lines REGEX "<ClCompile Include=")
 set(sources "")
 foreach(line IN LISTS source_lines)
  string(REGEX REPLACE ".*Include=\"([^\"]+)\".*" "\\1" source "${line}")
  string(REPLACE "\\" "/" source "${source}")
  # (..\Libraries: Dear ImGui, which the platform's UI library supplies (cane_ui on the desktop); glad.c: likewise)
  if(NOT source MATCHES "^\\.\\." AND NOT source STREQUAL "glad.c")
   list(APPEND sources "${SLY1_GAME_DIR}/${source}")
  endif()
 endforeach()
 # The PS2 SPU reverb is an XAPO (Windows XAudio2 only); elsewhere FAudio's reverb.
 if(NOT WIN32)
  list(REMOVE_ITEM sources "${SLY1_GAME_DIR}/spu_reverb_xapo.cpp")
 endif()
 # miniz (MIT; Libraries/miniz): the PS3 HD import's .zip sources (platform/ps3disc.h)
 list(APPEND sources "${CANE_ROOT_DIR}/Libraries/miniz/miniz.c")
 set_source_files_properties("${CANE_ROOT_DIR}/Libraries/miniz/miniz.c" TARGET_DIRECTORY ${target} PROPERTIES
  SKIP_PRECOMPILE_HEADERS ON)
 target_include_directories(${target} PRIVATE "${CANE_ROOT_DIR}/Libraries/miniz")
 # SafeHouse's own files in the fork (Sly1-Release/safehouse/: settings, frame pacing, cutscene skip, ...), built only
 # here (CANE_SAFEHOUSE), not listed in upstream's vcxproj
 file(GLOB safehouse_sources CONFIGURE_DEPENDS "${SLY1_GAME_DIR}/safehouse/*.cpp")
 target_sources(${target} PRIVATE ${sources} ${safehouse_sources} "${CANE_ROOT_DIR}/Libraries/include/imgui/imgui_demo.cpp")

 # <safehouse/platform.h>: a forwarding header to SafeHouse's platform/platform.h (paths, command line, Android / Apple /
 # Switch folders: one platform layer for every game)
 # Every SafeHouse platform header the same way (<safehouse/sly1_settings.h>, <safehouse/frame_pacer.h>, ...): the
 # fork's files never name SafeHouse's folders.
 set(include "${CMAKE_BINARY_DIR}/sly1-include")
 file(MAKE_DIRECTORY "${include}/safehouse")
 file(GLOB_RECURSE platform_headers CONFIGURE_DEPENDS RELATIVE "${CANE_ROOT_DIR}/platform" "${CANE_ROOT_DIR}/platform/*.h")
 foreach(header IN LISTS platform_headers)
  file(CONFIGURE OUTPUT "${include}/safehouse/${header}"
   CONTENT "#pragma once\n// Generated by cmake/sly1.cmake: SafeHouse's platform/${header} for the Sly 1 submodule.\n#include \"${CANE_ROOT_DIR}/platform/${header}\"\n")
 endforeach()
 target_include_directories(${target} PRIVATE "${include}" "${CMAKE_BINARY_DIR}/sly1-generated")
 target_compile_definitions(${target} PRIVATE CANE_SAFEHOUSE CANE_PORTABLE_SHADERS _CRT_SECURE_NO_WARNINGS
  _ENABLE_EXTENDED_ALIGNED_STORAGE)
 if(NOT MSVC)
  # -ffp-contract=off keeps float results identical if a target with FMA is ever selected; baseline x86-64 and
  # x86-64-v2 have no FMA.
  target_compile_options(${target} PRIVATE -fno-strict-aliasing -Wno-invalid-offsetof -ffp-contract=off)
 endif()

 # The GLSL programs, embedded (glshaders.cpp CANE_PORTABLE_SHADERS: no shader files beside the program)
 file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/sly1-generated")
 file(GLOB shader_inputs CONFIGURE_DEPENDS "${SLY1_GAME_DIR}/*.vert" "${SLY1_GAME_DIR}/*.frag" "${SLY1_GAME_DIR}/*.geom")
 add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/sly1-generated/embedded_shaders.h"
  COMMAND ${CMAKE_COMMAND} -DSOURCE=${SLY1_GAME_DIR} -DOUTPUT=${CMAKE_BINARY_DIR}/sly1-generated/embedded_shaders.h
          -P ${CANE_ROOT_DIR}/cmake/embed-shaders.cmake
  DEPENDS ${shader_inputs} ${CANE_ROOT_DIR}/cmake/embed-shaders.cmake VERBATIM)
 target_sources(${target} PRIVATE "${CMAKE_BINARY_DIR}/sly1-generated/embedded_shaders.h")

 # The port's version for the debug menu's title line (Sly1-Release/safehouse/debugmenu.cpp): the release version and
 # the short git hash, as Sly 2's (cmake/sly2-version.cmake; SLY2_PORT_VERSION in sly1_version.h), at every build
 if(NOT TARGET sly1_version)
  add_custom_target(sly1_version
   COMMAND ${CMAKE_COMMAND} -DROOT=${CANE_ROOT_DIR} -DRELEASE=${SAFEHOUSE_VERSION} -DHASH=${CANE_GIT_HASH}
           -DOUTPUT=${CMAKE_BINARY_DIR}/sly1-generated/sly1_version.h -P ${CANE_ROOT_DIR}/cmake/sly2-version.cmake
   BYPRODUCTS "${CMAKE_BINARY_DIR}/sly1-generated/sly1_version.h" VERBATIM)
 endif()
 add_dependencies(${target} sly1_version)

 # Upstream's precompiled headers
 foreach(header platform/platform.h Sly1-Release/sw.h Sly1-Release/save.h Sly1-Release/freeze.h Sly1-Release/act.h
                Sly1-Release/wr.h Sly1-Release/shadow.h Sly1-Release/fader.h Sly1-Release/splicemap.h Sly1-Release/gc.h)
  target_precompile_headers(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${SLY1_DIR}/${header}>")
 endforeach()
 set_source_files_properties("${SLY1_GAME_DIR}/alo.cpp" TARGET_DIRECTORY ${target} PROPERTIES
  COMPILE_DEFINITIONS ALO_IMPLEMENTATION SKIP_PRECOMPILE_HEADERS ON)
endfunction()

# cane_sly1_metal_programs(TARGET): macOS / iOS. Sly 1's GLSL programs as Metal Shading Language, made at build time
# (cmake/metal_shaders.py: glslangValidator to SPIR-V, SPIRV-Cross to MSL; Homebrew's glslang and spirv-cross on a
# Mac), with the table platform/metal/prebuilt_programs.mm takes them from (cane::gl_metal::Program). Both tools are
# required: Apple has no OpenGL renderer to fall back to.
function(cane_sly1_metal_programs target)
 find_program(SLY1_GLSLANG NAMES glslangValidator glslang)
 find_program(SLY1_SPIRV_CROSS NAMES spirv-cross)
 find_package(Python3 COMPONENTS Interpreter QUIET)
 if(NOT SLY1_GLSLANG OR NOT SLY1_SPIRV_CROSS OR NOT Python3_Interpreter_FOUND)
  message(FATAL_ERROR "Sly 1 on Metal needs glslangValidator, spirv-cross and Python 3 at build time "
   "(brew install glslang spirv-cross), found: '${SLY1_GLSLANG}' '${SLY1_SPIRV_CROSS}'")
 endif()
 set(out "${CMAKE_BINARY_DIR}/sly1-generated/metal")
 file(MAKE_DIRECTORY "${out}")
 file(GLOB inputs CONFIGURE_DEPENDS "${SLY1_GAME_DIR}/*.vert" "${SLY1_GAME_DIR}/*.frag"
  "${CANE_ROOT_DIR}/platform/vulkan/shaders/imgui.*")
 file(RELATIVE_PATH game_rel "${CANE_ROOT_DIR}" "${SLY1_GAME_DIR}")
 set(ios_flag "")
 if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  set(ios_flag --ios)
 endif()
 add_custom_command(OUTPUT "${out}/metal_programs.cpp"
  COMMAND ${Python3_EXECUTABLE} ${CANE_ROOT_DIR}/cmake/metal_shaders.py --source ${CANE_ROOT_DIR} --game ${game_rel}
          --output ${out} --glslang ${SLY1_GLSLANG} --spirv-cross ${SLY1_SPIRV_CROSS} ${ios_flag}
  DEPENDS ${inputs} ${CANE_ROOT_DIR}/cmake/metal_shaders.py ${CANE_ROOT_DIR}/cmake/switch_shaders.py VERBATIM)
 target_sources(${target} PRIVATE "${out}/metal_programs.cpp" "${CANE_ROOT_DIR}/platform/metal/prebuilt_programs.mm"
  "${CANE_ROOT_DIR}/platform/render/imgui_gl.cpp")
 set_source_files_properties("${out}/metal_programs.cpp" "${CANE_ROOT_DIR}/platform/metal/prebuilt_programs.mm"
  "${CANE_ROOT_DIR}/platform/render/imgui_gl.cpp" TARGET_DIRECTORY ${target} PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
 set_source_files_properties("${CANE_ROOT_DIR}/platform/metal/prebuilt_programs.mm" TARGET_DIRECTORY ${target}
  PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
 target_include_directories(${target} PRIVATE "${CANE_ROOT_DIR}/platform/metal")
 message(STATUS "Sly 1: Metal programs from ${SLY1_GLSLANG} + ${SLY1_SPIRV_CROSS}")
endfunction()

# cane_sly1_renderer(TARGET): the renderer choice (platform/vulkan/vk_game.h: Auto = Vulkan with OpenGL as the
# fallback, as Sly 2 and Sly 3) and Vulkan itself: Sly 2's OpenGL-on-Vulkan layer (platform/vulkan/gl_vulkan.cpp), Sly 1's
# programs compiled to SPIR-V at build time (cmake/vulkan_shaders.py --game Sly1/Sly1-Release). Linux, Windows and
# Android (phones and the Quest: Vulkan only there, the game's OpenGL 4.3 has no OpenGL ES path); without
# glslangValidator or Python the game builds without it (OpenGL only).
if(WIN32 OR ANDROID OR (UNIX AND NOT APPLE))
 set(sly1_vulkan_default ON)
else()
 set(sly1_vulkan_default OFF)
endif()
option(SLY1_VULKAN "Sly 1's Vulkan renderer (needs glslangValidator and Python 3 at build time)" ${sly1_vulkan_default})
function(cane_sly1_renderer target)
 target_sources(${target} PRIVATE "${CANE_ROOT_DIR}/platform/vulkan/vk_game.cpp" "${CANE_ROOT_DIR}/platform/render/imgui_gl.cpp")
 # (the start marker's version: a new build tries Auto's Vulkan again after a failed start)
 set_property(SOURCE "${CANE_ROOT_DIR}/platform/vulkan/vk_game.cpp" TARGET_DIRECTORY ${target} APPEND PROPERTY COMPILE_DEFINITIONS
  "CANE_GAME_VERSION=\"sly1 ${SAFEHOUSE_VERSION} ${CANE_GIT_HASH}\"")
 set_source_files_properties("${CANE_ROOT_DIR}/platform/vulkan/vk_game.cpp" "${CANE_ROOT_DIR}/platform/render/imgui_gl.cpp"
  TARGET_DIRECTORY ${target} PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
 # OpenGL ES (platform/render/gles_sly1.h): Android's fallback when Vulkan is missing or fails; on Linux the test mode
 # SLY1_RENDERER=gles (the same path on the desktop driver's ES context)
 if(ANDROID OR (CMAKE_SYSTEM_NAME STREQUAL "Linux"))
  target_sources(${target} PRIVATE "${CANE_ROOT_DIR}/platform/render/gles_sly1.cpp")
  set_source_files_properties("${CANE_ROOT_DIR}/platform/render/gles_sly1.cpp" TARGET_DIRECTORY ${target}
   PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
  target_compile_definitions(${target} PRIVATE CANE_GLES1=1)
 endif()
 set(SLY1_VULKAN_BUILT OFF PARENT_SCOPE)
 if(NOT SLY1_VULKAN)
  return()
 endif()
 find_program(SLY1_GLSLANG NAMES glslangValidator glslang)
 find_package(Python3 COMPONENTS Interpreter QUIET)
 if(NOT SLY1_GLSLANG OR NOT Python3_Interpreter_FOUND)
  message(WARNING "Sly 1: no glslangValidator or Python 3: built without the Vulkan renderer (OpenGL only)")
  return()
 endif()
 file(GLOB sly1_vk_shaders CONFIGURE_DEPENDS "${SLY1_GAME_DIR}/*.vert" "${SLY1_GAME_DIR}/*.frag" "${SLY1_GAME_DIR}/*.geom"
  "${CANE_ROOT_DIR}/platform/vulkan/shaders/*")
 set(sly1_vk_out "${CMAKE_BINARY_DIR}/sly1-generated/vk")
 file(MAKE_DIRECTORY "${sly1_vk_out}")
 file(RELATIVE_PATH sly1_game_rel "${CANE_ROOT_DIR}" "${SLY1_GAME_DIR}")
 add_custom_command(OUTPUT "${sly1_vk_out}/vk_shaders.cpp"
  COMMAND ${Python3_EXECUTABLE} ${CANE_ROOT_DIR}/cmake/vulkan_shaders.py --source ${CANE_ROOT_DIR} --output ${sly1_vk_out}
          --glslang ${SLY1_GLSLANG} --game ${sly1_game_rel}
  DEPENDS ${sly1_vk_shaders} ${CANE_ROOT_DIR}/cmake/vulkan_shaders.py ${CANE_ROOT_DIR}/cmake/switch_shaders.py
          ${CANE_ROOT_DIR}/cmake/glsl_fuse.py VERBATIM)
 target_sources(${target} PRIVATE "${CANE_ROOT_DIR}/platform/vulkan/gl_vulkan.cpp"
  "${CANE_ROOT_DIR}/platform/vulkan/vk_loader.cpp" "${sly1_vk_out}/vk_shaders.cpp")
 set_source_files_properties("${CANE_ROOT_DIR}/platform/vulkan/gl_vulkan.cpp" "${CANE_ROOT_DIR}/platform/vulkan/vk_loader.cpp"
  "${sly1_vk_out}/vk_shaders.cpp" TARGET_DIRECTORY ${target} PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
 target_include_directories(${target} PRIVATE "${CANE_ROOT_DIR}/platform/vulkan")
 target_compile_definitions(${target} PRIVATE CANE_VULKAN=1)
 set(SLY1_VULKAN_BUILT ON PARENT_SCOPE)
 message(STATUS "Sly 1: Vulkan renderer on (${SLY1_GLSLANG})")
endfunction()

# The Android app builds its own Sly 1 library from the functions above (cmake/android.cmake: libSly1-Release.so).
if(ANDROID)
 return()
endif()

# The Nintendo Switch (cmake/Switch.cmake) builds its own game object with cane_sly1_game(); no program here.
if(NINTENDO_SWITCH)
 return()
endif()

# ---- iOS / iPadOS (cmake/ios.cmake): Sly1Release.framework, as Sly 2's Sly2Release: the app's bridge runs main.cpp's
# main under another name in the app's own process (platform/ios/program_entry.cpp, ios_app.mm), the game on the main
# thread; scripts/ios/package.py copies it to Sly1Tools for the tool commands (--gl-selftest, the PS3 HD import).
if(CANE_IOS)
 add_library(Sly1-Release SHARED "${CANE_ROOT_DIR}/platform/ios/program_entry.cpp")
 cane_sly1_game(Sly1-Release)
 set_property(SOURCE "${SLY1_GAME_DIR}/main.cpp" TARGET_DIRECTORY Sly1-Release APPEND PROPERTY
  COMPILE_DEFINITIONS main=cane_sly1_main)
 set_source_files_properties("${CANE_ROOT_DIR}/platform/ios/program_entry.cpp" TARGET_DIRECTORY Sly1-Release
  PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
 target_compile_definitions(Sly1-Release PRIVATE CANE_IOS_ENTRY=cane_sly1_main "CANE_IOS_ROLE=\"game\"")
 target_include_directories(Sly1-Release PRIVATE "${CANE_ROOT_DIR}/platform/apple")
 include("${CANE_ROOT_DIR}/cmake/ffmpeg.cmake")
 cane_link_ffmpeg(Sly1-Release avformat avcodec avutil swscale)
 # (FAudio and SDL: cmake/ios.cmake's, SDL inside SafeHouseCore, which every program shares)
 target_link_libraries(Sly1-Release PRIVATE cane_platform cane_ui cane_sdl cane_gl_metal FAudio-static
  Threads::Threads "-framework Foundation" "-framework UIKit" "-framework Metal" "-framework QuartzCore")
 cane_sly1_metal_programs(Sly1-Release)
 cane_ios_framework(Sly1-Release Sly1Release)
 return()
endif()

# ---- The desktop program (Linux, Windows, macOS)
add_executable(Sly1-Release)
cane_sly1_game(Sly1-Release)
target_link_libraries(Sly1-Release PRIVATE cane_ui Threads::Threads)
cane_sly1_renderer(Sly1-Release)
if(WIN32)
 # the frames' DXGI flip-model presentation (platform/gl_context.h cane::gl::dxgi), as Sly 2's and Sly 3's
 target_sources(Sly1-Release PRIVATE "${CANE_ROOT_DIR}/platform/win32/gl_present_dxgi.cpp")
 set_source_files_properties("${CANE_ROOT_DIR}/platform/win32/gl_present_dxgi.cpp" TARGET_DIRECTORY Sly1-Release PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
endif()
# Linux: the smoke hooks (tools/sly1-smoke-hooks.cpp, tools/sly1-smoke.sh: hidden window, screenshots, scripted keys,
# mouse and a virtual controller;
# inert unless SAFEHOUSE_SLY1_SMOKE is set), wrapping GLFW at the link so the submodule needs no test code.
# CANE_SLY1_SMOKE_HOOKS=ON also links them into a MinGW (llvm-mingw) Windows test build, for runs under Proton
# (tools/sly1-wine-smoke.sh); release packages for Windows leave them out.
set(cane_sly1_smoke_default OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 set(cane_sly1_smoke_default ON)
endif()
option(CANE_SLY1_SMOKE_HOOKS "Sly 1: link the smoke test's GLFW hooks (Linux, or a MinGW Windows test build)" ${cane_sly1_smoke_default})
if(CANE_SLY1_SMOKE_HOOKS AND (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR MINGW))
 target_sources(Sly1-Release PRIVATE "${CANE_ROOT_DIR}/tools/sly1-smoke-hooks.cpp")
 set_source_files_properties("${CANE_ROOT_DIR}/tools/sly1-smoke-hooks.cpp" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
 foreach(function glfwCreateWindow glfwSwapBuffers glfwGetKey glfwGetWindowAttrib glfwGetMouseButton glfwGetCursorPos
                  glfwSetInputMode glfwGetInputMode glfwSetScrollCallback glfwJoystickPresent glfwJoystickIsGamepad
                  glfwGetGamepadState glfwGetJoystickGUID glfwGetJoystickName glfwGetGamepadName glfwGetJoystickAxes
                  glfwGetJoystickButtons glfwGetJoystickHats)
  target_link_options(Sly1-Release PRIVATE "-Wl,--wrap=${function}")
 endforeach()
 if(SLY1_VULKAN_BUILT)
  target_link_options(Sly1-Release PRIVATE -Wl,--wrap=_ZN6CaneVk7PresentEv)   # (CaneVk::Present)
 endif()
endif()
if(NOT MSVC AND CANE_X86_64_V2)
 target_compile_options(Sly1-Release PRIVATE -march=x86-64-v2 -mtune=generic)
elseif(CANE_X86_64_V2)
 message(WARNING "CANE_X86_64_V2 is ignored for MSVC builds")
endif()

if(WIN32)
 if(NOT CANE_FFMPEG_ROOT)
  set(CANE_FFMPEG_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/Libraries/ffmpeg/ffmpeg-master-latest-win64-lgpl-shared")
 endif()
 target_include_directories(Sly1-Release PRIVATE "${CANE_FFMPEG_ROOT}/include")
 target_link_directories(Sly1-Release PRIVATE "${CANE_FFMPEG_ROOT}/lib")
 target_link_libraries(Sly1-Release PRIVATE opengl32 winmm avformat avcodec avutil swscale)
 if(MINGW)
  # LLVM/MinGW has no XAudio2 import library: the redistributable XAudio2 2.9 (NuGet), its DLL beside the game
  FetchContent_Declare(xaudio2 URL https://www.nuget.org/api/v2/package/Microsoft.XAudio2.Redist/1.2.13 DOWNLOAD_NAME xaudio2.zip URL_HASH SHA256=bc83d03f6b8615742e583317360336905a104bfa4d30a4d05da65fca424840a2)
  FetchContent_MakeAvailable(xaudio2)
  if(CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM64")
   set(cane_xaudio2_arch arm64)
  else()
   set(cane_xaudio2_arch x64)
  endif()
  target_link_libraries(Sly1-Release PRIVATE "${xaudio2_SOURCE_DIR}/build/native/release/lib/${cane_xaudio2_arch}/xaudio2_9redist.lib")
  # The game includes <xaudio2.h>, <xaudio2fx.h> and <xapo.h>: MinGW's own copies lack the reverb (XAudio2CreateReverb,
  # the I3DL2 presets) and XAPOAlloc, so the redistributable's SDK headers come first (include names' case fixed for a
  # case-sensitive host).
  set(xaudio2_include "${CMAKE_BINARY_DIR}/sly1-xaudio2")
  file(MAKE_DIRECTORY "${xaudio2_include}")
  file(GLOB xaudio2_headers "${xaudio2_SOURCE_DIR}/build/native/include/*.h")
  foreach(header IN LISTS xaudio2_headers)
   get_filename_component(name "${header}" NAME)
   file(READ "${header}" text)
   string(REPLACE "<AudioSessionTypes.h>" "<audiosessiontypes.h>" text "${text}")
   string(REPLACE "<Windows.h>" "<windows.h>" text "${text}")
   file(WRITE "${xaudio2_include}/${name}.new" "${text}")
   file(COPY_FILE "${xaudio2_include}/${name}.new" "${xaudio2_include}/${name}" ONLY_IF_DIFFERENT)
   # (their stubs include each other in lower case: xaudio2.h -> "xaudio2redist.h")
   string(TOLOWER "${name}" lower)
   file(COPY_FILE "${xaudio2_include}/${name}.new" "${xaudio2_include}/${lower}" ONLY_IF_DIFFERENT)
   file(REMOVE "${xaudio2_include}/${name}.new")
  endforeach()
  target_include_directories(Sly1-Release BEFORE PRIVATE "${xaudio2_include}")
  # Release builds start at upstream's wWinMain (main.cpp: _WIN32 and NDEBUG; a GUI program, no console)
  target_link_options(Sly1-Release PRIVATE "$<$<NOT:$<CONFIG:Debug>>:-municode;-mwindows>")
  install(FILES "${xaudio2_SOURCE_DIR}/build/native/release/bin/${cane_xaudio2_arch}/xaudio2_9redist.dll" DESTINATION bin)
  install(FILES "${xaudio2_SOURCE_DIR}/LICENSE.txt" DESTINATION licenses/xaudio2)
 else()
  target_link_libraries(Sly1-Release PRIVATE xaudio2)
 endif()
 # (SDL2 for the controllers: the top-level CMakeLists.txt fetches it on Windows and links it below)
else()
 if(APPLE)
  # macOS: scripts/macos/ffmpeg.sh's FFmpeg (CANE_FFMPEG_ROOT; avformat for the .m2v movies), or Homebrew's
  include("${CANE_ROOT_DIR}/cmake/ffmpeg.cmake")
  cane_link_ffmpeg(Sly1-Release avformat avcodec avutil swscale)
 else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET libavformat libavcodec libavutil libswscale)
  target_link_libraries(Sly1-Release PRIVATE PkgConfig::FFMPEG)
 endif()
 # Ubuntu 22.04 ships SDL 2.0.20; FAudio requires 2.24 or newer.
 # Prefer an explicitly selected/system development package when compatible.
 find_package(SDL2 2.24 CONFIG QUIET)
 if(NOT SDL2_FOUND)
  set(SDL_SHARED ON CACHE BOOL "" FORCE)
  set(SDL_STATIC OFF CACHE BOOL "" FORCE)
  set(SDL_TEST OFF CACHE BOOL "" FORCE)
  set(SDL2_DISABLE_INSTALL OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(sdl2 URL https://codeload.github.com/libsdl-org/SDL/tar.gz/refs/tags/release-2.30.11 URL_HASH SHA256=cc6136dd964854e8846c679703322f3e2a341d27a06a53f8b3f642c26f1b0cfd)
  FetchContent_MakeAvailable(sdl2)
  set(SDL2_INCLUDE_DIRS "${sdl2_SOURCE_DIR}/include;${sdl2_BINARY_DIR}/include")
  set(SDL2_LIBRARIES SDL2::SDL2)
 endif()
 set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
 FetchContent_Declare(faudio URL https://codeload.github.com/FNA-XNA/FAudio/tar.gz/refs/tags/25.02 URL_HASH SHA256=eab667d231e5036b0e5c3c6f89fb4ea792284493d46161bc056a88a6dadc2683)
 FetchContent_MakeAvailable(faudio)
 if(TARGET FAudio-shared)
  set(cane_audio_target FAudio-shared)
 else()
  set(cane_audio_target FAudio-static)
 endif()
 # (upstream's platform/audio_linux.h: XAudio2 on FAudio)
 target_link_libraries(Sly1-Release PRIVATE ${cane_audio_target} SDL2::SDL2)
 # SDL2 drives the controllers' motors only (platform/pad_rumble.h); input comes through GLFW (controller_family.h)
 target_compile_definitions(Sly1-Release PRIVATE CANE_SDL_RUMBLE SDL_MAIN_HANDLED)
endif()

# macOS: the game's OpenGL calls run on Metal (platform/metal, as Sly 2's and Sly 3's), Sly 1's programs as Metal
# Shading Language made at build time (cane_sly1_metal_programs: cmake/metal_shaders.py); platform/apple: the glibc
# headers the code includes.
if(APPLE)
 target_link_libraries(Sly1-Release PRIVATE cane_gl_metal)
 target_include_directories(Sly1-Release PRIVATE "${CANE_ROOT_DIR}/platform/apple")
 cane_sly1_metal_programs(Sly1-Release)
endif()
