if(NOT EXTENSIONS)
 set(EXTENSIONS vert frag geom)
endif()
if(NOT FUNCTION)
 set(FUNCTION CaneEmbeddedShader)
endif()
set(patterns "")
foreach(extension IN LISTS EXTENSIONS)
 list(APPEND patterns "${SOURCE}/*.${extension}")
endforeach()
file(GLOB shaders ${patterns})
list(SORT shaders)
file(WRITE "${OUTPUT}" "#pragma once\n#include <string>\n#include <stdexcept>\ninline std::string ${FUNCTION}(const std::string& name) {\n")
foreach(shader IN LISTS shaders)
 get_filename_component(name "${shader}" NAME)
 file(READ "${shader}" source)
 string(ASCII 239 187 191 bom)
 string(REGEX REPLACE "^${bom}" "" source "${source}")
 file(APPEND "${OUTPUT}" "if(name == \"${name}\") return R\"CANESHADER(${source})CANESHADER\";\n")
endforeach()
file(APPEND "${OUTPUT}" "throw std::runtime_error(\"Unknown embedded shader: \"+name);\n}\n")
