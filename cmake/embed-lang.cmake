# Embeds the launcher's language files (launcher/lang/<code>.json) as cane_lang_blobs in one header
# (launcher/l10n.h reads it). English first, then the files by name. Usage: -DDIR=launcher/lang -DOUTPUT=header.
file(GLOB files RELATIVE "${DIR}" "${DIR}/*.json")
list(SORT files)
list(REMOVE_ITEM files "en.json")
list(PREPEND files "en.json")
set(body "#pragma once\n#include <cstddef>\nstruct CaneLangBlob {\n    const char* code;\n    const char* data;\n    std::size_t size;\n};\n")
set(table "")
foreach(name IN LISTS files)
 string(REGEX REPLACE "\\.json$" "" code "${name}")
 string(MAKE_C_IDENTIFIER "${code}" symbol)
 file(READ "${DIR}/${name}" bytes HEX)
 string(LENGTH "${bytes}" hexlength)
 math(EXPR size "${hexlength} / 2")
 string(REGEX REPLACE "(..)" "'\\\\x\\1'," bytes "${bytes}")
 string(APPEND body "inline const char cane_lang_${symbol}[] = {${bytes}0};\n")
 string(APPEND table "    {\"${code}\", cane_lang_${symbol}, ${size}},\n")
endforeach()
string(APPEND body "inline const CaneLangBlob cane_lang_blobs[] = {\n${table}};\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
