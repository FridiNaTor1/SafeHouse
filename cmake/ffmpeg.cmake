function(cane_link_ffmpeg target)
 set(modules ${ARGN})
 if(NOT CANE_FFMPEG_ROOT)
  find_package(PkgConfig QUIET)
  if(PKG_CONFIG_FOUND)
   string(MAKE_C_IDENTIFIER "${target}_FFMPEG" prefix)
   set(pc_modules "")
   foreach(module IN LISTS modules)
    list(APPEND pc_modules "lib${module}")
   endforeach()
   pkg_check_modules(${prefix} REQUIRED IMPORTED_TARGET ${pc_modules})
   target_link_libraries(${target} PRIVATE PkgConfig::${prefix})
   return()
  endif()
 endif()
 if(CANE_FFMPEG_ROOT)
  set(hints "${CANE_FFMPEG_ROOT}")
  set(scope NO_DEFAULT_PATH)
 else()
  set(hints /opt/homebrew/opt/ffmpeg /usr/local/opt/ffmpeg /opt/local)
  set(scope "")
 endif()
 find_path(CANE_FFMPEG_INCLUDE_DIR libavcodec/avcodec.h HINTS ${hints} PATH_SUFFIXES include ${scope})
 if(NOT CANE_FFMPEG_INCLUDE_DIR)
  message(FATAL_ERROR "FFmpeg headers not found: install pkg-config and FFmpeg, or set CANE_FFMPEG_ROOT")
 endif()
 target_include_directories(${target} PRIVATE "${CANE_FFMPEG_INCLUDE_DIR}")
 foreach(module IN LISTS modules)
  find_library(CANE_FFMPEG_${module}_LIBRARY ${module} HINTS ${hints} PATH_SUFFIXES lib ${scope})
  if(NOT CANE_FFMPEG_${module}_LIBRARY)
   message(FATAL_ERROR "FFmpeg library ${module} not found")
  endif()
  target_link_libraries(${target} PRIVATE "${CANE_FFMPEG_${module}_LIBRARY}")
 endforeach()
endfunction()
