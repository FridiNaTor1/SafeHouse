# CANE_MINGW_ARCH: x86_64 (default) or aarch64 (cmake/mingw-toolchain-arm64.cmake); LLVM/MinGW hosted on Linux or Windows.
if(NOT CANE_MINGW_ARCH)
 set(CANE_MINGW_ARCH x86_64)
endif()
set(CMAKE_SYSTEM_NAME Windows)
if(CANE_MINGW_ARCH STREQUAL "aarch64")
 set(CMAKE_SYSTEM_PROCESSOR ARM64)
else()
 set(CMAKE_SYSTEM_PROCESSOR AMD64)
endif()
if(NOT CANE_MINGW_ROOT)
 set(CANE_MINGW_ROOT "$ENV{CANE_MINGW_ROOT}" CACHE PATH "LLVM/MinGW installation")
endif()
if(NOT CANE_MINGW_ROOT)
 message(FATAL_ERROR "Set CANE_MINGW_ROOT to an LLVM/MinGW installation")
endif()
file(TO_CMAKE_PATH "${CANE_MINGW_ROOT}" CANE_MINGW_ROOT)
if(CMAKE_HOST_WIN32)
 set(cane_mingw_exe ".exe")
endif()
set(cane_mingw_target "${CANE_MINGW_ARCH}-w64-mingw32")
set(CMAKE_C_COMPILER "${CANE_MINGW_ROOT}/bin/${cane_mingw_target}-clang${cane_mingw_exe}")
set(CMAKE_CXX_COMPILER "${CANE_MINGW_ROOT}/bin/${cane_mingw_target}-clang++${cane_mingw_exe}")
set(CMAKE_RC_COMPILER "${CANE_MINGW_ROOT}/bin/${cane_mingw_target}-windres${cane_mingw_exe}")
set(CMAKE_FIND_ROOT_PATH "${CANE_MINGW_ROOT}/${cane_mingw_target}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
