<?xml version="1.0" encoding="utf-8"?>
<!-- SafeHouse for Android (android/README.md): the launcher, the extractor and Sly 2 in private processes of one app.
     No game data is packaged: the player imports their own disc image with the document picker. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- VR (Sly2-Release/vr.cpp, notes/VR_2026-11-10.md): an OpenXR headset when there is one (Meta Quest); not required -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" android:version="1" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
        <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    </queries>
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the USB Headset option's microphone (SDL asks at run time when the headset is turned on) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application android:label="SafeHouse" android:icon="@drawable/safehouse_icon" android:appCategory="game"
        android:theme="@style/SafeHouseTheme" android:allowBackup="false"
        android:hasFragileUserData="true" android:resizeableActivity="true">
        <!-- Samsung DeX: keep the processes when the app moves between the phone and the desktop display -->
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
        <!-- Meta Quest: the launcher is a 2D panel, the game (GameActivity) the immersive part (a hybrid app) -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <activity android:name=".LauncherActivity" android:exported="true"
            android:launchMode="singleTask" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|colorMode">
            <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" android:minWidth="640dp" android:minHeight="400dp" android:gravity="center" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Pinned shortcuts (a game, the Collection Style Launcher) and the Collection Style Launcher itself: the launcher
             program without its window (DirectActivity.java) -->
        <activity android:name=".DirectActivity" android:exported="false" android:process=":direct"
            android:launchMode="singleTask" android:taskAffinity="org.safehouse.android.direct"
            android:excludeFromRecents="true" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|colorMode">
            <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" android:minWidth="640dp" android:minHeight="400dp" android:gravity="center" />
        </activity>
        <activity android:name=".GameActivity" android:exported="false" android:process=":game"
            android:launchMode="singleTask" android:taskAffinity="org.safehouse.android.game"
            android:excludeFromRecents="true" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|colorMode">
            <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" android:minWidth="320dp" android:minHeight="240dp" android:gravity="center" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.oculus.intent.category.VR" /></intent-filter>
        </activity>
        <service android:name=".ExtractorService" android:exported="false" android:process=":extract" />
        <service android:name=".RuntimeToolService" android:exported="false" android:process=":tool" />
        <service android:name=".LauncherKeeperService" android:exported="false" />
        <service android:name=".RuntimeKeeperService" android:exported="false" android:process=":game" />
        <provider android:name=".SafeHouseDocumentsProvider" android:authorities="org.safehouse.android.documents"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
